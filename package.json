{
  "name": "@yunyoujun/ai",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "YunYouJun's AI development practices, tools, and Claude Code plugins",
  "author": "YunYouJun",
  "license": "MIT",
  "keywords": [
    "ai",
    "claude-code",
    "vitepress"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run docs:dev",
    "build": "pnpm run docs:build",
    "lint": "eslint .",
    "test": "vitest",
    "test:skills": "python3 -m unittest discover -s test/skills/simplify-documents -p 'test_*.py' -v",
    "typecheck": "tsc --noEmit",
    "docs:dev": "pnpm --filter @yyj/docs run docs:dev",
    "docs:build": "pnpm --filter @yyj/docs run docs:build",
    "docs:preview": "pnpm --filter @yyj/docs run docs:preview"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@yunyoujun/ai-docs": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
